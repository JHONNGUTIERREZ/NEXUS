        static void RecuperarEnergia(Explorador e)
        {
            Console.WriteLine("\n--- RECUPERAR ENERGÍA ---");

            if (e.NivelPeligro >= Explorador.PELIGRO_ALTO)
            {
                if (e.Estabilidad < Explorador.ESTABILIDAD_CRITICA)
                {
                    EscribirColor("NEXUS interrumpe el descanso: el peligro y la inestabilidad no dan tregua.", ConsoleColor.Red);
                    e.AjustarEnergia(5);
                    e.AjustarPeligro(10);
                }
                else
                {
                    EscribirColor("El descanso es breve e incómodo; el peligro sigue latente.", ConsoleColor.Yellow);
                    e.AjustarEnergia(10);
                    e.AjustarPeligro(5);
                }
                return;
            }

            int energiaAntes = e.Energia;
            e.AjustarEnergia(20);
            e.AjustarEstabilidad(5);
            int recuperadoReal = e.Energia - energiaAntes;

            if (recuperadoReal < 20)
                Console.WriteLine($"Energía recuperada: {recuperadoReal} (se alcanzó el límite máximo de 100).");
            else
                Console.WriteLine($"Energía recuperada: {recuperadoReal}.");

            Console.WriteLine("La pausa también ayudó a estabilizar ligeramente la conexión.");

            e.RealidadActual.Estabilizar(8);
            Console.WriteLine($"La realidad {e.Realidad} se calma un poco (inestabilidad: {e.RealidadActual.NivelInestabilidad}/100).");
        }

        static void IntentarDesconexion(Explorador e)
        {
            Console.WriteLine("\n--- INTENTO DE DESCONEXIÓN ---");

            if (e.ProtocoloDescubierto)
            {
                EscribirColor("NEXUS activa el Protocolo de Escape descubierto. Desconexión segura garantizada.", ConsoleColor.Cyan);
            }
            else if (e.Estabilidad < Explorador.ESTABILIDAD_CRITICA)
            {
                EscribirColor("⚠ La conexión es demasiado inestable para una desconexión segura.", ConsoleColor.Red);
                Console.WriteLine("NEXUS ejecuta un protocolo de desconexión de emergencia.");
            }
            else
            {
                Console.WriteLine("Desconexión autorizada. Cerrando enlace neuronal de forma segura.");
            }

            e.Conectado = false;
        }

