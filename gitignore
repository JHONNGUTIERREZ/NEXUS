        static bool EvaluarAutorizacion(Explorador e)
        {
            bool autorizado = true;
            Console.WriteLine("\nNEXUS está evaluando tus condiciones de ingreso...\n");

            if (e.Edad < Explorador.EDAD_MINIMA)
            {
                Console.WriteLine($"✗ Edad insuficiente. Se requieren al menos {Explorador.EDAD_MINIMA} años.");
                autorizado = false;
            }
            if (e.Energia < Explorador.ENERGIA_MIN_INGRESO)
            {
                Console.WriteLine($"✗ Energía insuficiente. Se requiere un mínimo de {Explorador.ENERGIA_MIN_INGRESO}.");
                autorizado = false;
            }
            if (e.Estabilidad < Explorador.ESTABILIDAD_MIN_INGRESO)
            {
                Console.WriteLine($"✗ Estabilidad de conexión insuficiente. Se requiere un mínimo de {Explorador.ESTABILIDAD_MIN_INGRESO}.");
                autorizado = false;
            }

            if (autorizado)
                Console.WriteLine("✓ Todas las condiciones se cumplen.");

            return autorizado;
        }

