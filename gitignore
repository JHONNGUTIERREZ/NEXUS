        static void MostrarBarra(string etiqueta, int valor, int umbralCritico, int umbralAdvertencia,
            bool invertido = false, int umbralBajo = 0, int umbralAlto = 0)
        {
            int bloques = Math.Max(0, Math.Min(10, valor / 10));
            string barra = new string('█', bloques) + new string('░', 10 - bloques);

            ConsoleColor color;
            if (!invertido)
            {
                if (valor < umbralCritico) color = ConsoleColor.Red;
                else if (valor < umbralAdvertencia) color = ConsoleColor.Yellow;
                else color = ConsoleColor.Green;
            }
            else
            {
                if (valor >= umbralAlto) color = ConsoleColor.Red;
                else if (valor >= umbralBajo) color = ConsoleColor.Yellow;
                else color = ConsoleColor.Green;
            }

            Console.Write($"{etiqueta} [");
            EscribirColor(barra, color, salto: false);
            Console.WriteLine($"] {valor}/100");
        }

        static void EscribirColor(string mensaje, ConsoleColor color, bool salto = true)
        {
            lock (ConsoleLock)
            {
                ConsoleColor original = Console.ForegroundColor;
                Console.ForegroundColor = color;
                if (salto) Console.WriteLine(mensaje);
                else Console.Write(mensaje);
                Console.ForegroundColor = original;
            }
        }

