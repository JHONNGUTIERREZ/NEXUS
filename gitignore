        // ================= Lectura y validación de datos =================

        static string LeerTexto(string mensaje)
        {
            string texto;
            do
            {
                Console.Write(mensaje);
                texto = Console.ReadLine() ?? "";
                if (string.IsNullOrWhiteSpace(texto))
                    Console.WriteLine("⚠ Este dato no puede quedar vacío. Intenta de nuevo.");
            } while (string.IsNullOrWhiteSpace(texto));

            return texto.Trim();
        }

        static int LeerEnteroEnRango(string mensaje, int min, int max)
        {
            while (true)
            {
                Console.Write(mensaje);
                string entrada = Console.ReadLine() ?? "";

                int valor;
                if (!int.TryParse(entrada, out valor))
                {
                    Console.WriteLine("⚠ Debes ingresar un número entero válido (ejemplo: 25).");
                    continue;
                }

                if (valor < min || valor > max)
                {
                    Console.WriteLine($"⚠ El valor debe estar entre {min} y {max}. Intenta de nuevo.");
                    continue;
                }

                return valor;
            }
        }

        // Para el menú: si no es un número lanza OperacionInvalidaException (se captura en Main).
        static int LeerEntero(string mensaje)
        {
            Console.Write(mensaje);
            string entrada = Console.ReadLine() ?? "";

            int valor;
            if (!int.TryParse(entrada, out valor))
                throw new OperacionInvalidaException("Debes ingresar solo un número para seleccionar la operación.");

            return valor;
        }
