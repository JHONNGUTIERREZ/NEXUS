    enum EstadoRealidad
    {
        Estable,
        Inestable,
        Critica
    }

    class RealidadDimensional
    {
        public const int INESTABILIDAD_MAX = 100;
        public const int INESTABILIDAD_MIN = 0;
        public const int UMBRAL_INESTABLE = 40;
        public const int UMBRAL_CRITICA = 75;

        private readonly string nombre;
        private readonly int factorRiesgo;
        private int nivelInestabilidad;
        private int vecesExploradas;
        private EstadoRealidad estado;

        public string Nombre { get { return nombre; } }
        public int FactorRiesgo { get { return factorRiesgo; } }
        public int NivelInestabilidad { get { return nivelInestabilidad; } }
        public int VecesExploradas { get { return vecesExploradas; } }
        public EstadoRealidad Estado { get { return estado; } }

        public event Action<RealidadDimensional, EstadoRealidad, EstadoRealidad> EstadoCambiado;

        public RealidadDimensional(string nombre, int inestabilidadInicial, int factorRiesgo)
        {
            if (string.IsNullOrWhiteSpace(nombre))
                throw new ArgumentException("Una realidad debe tener nombre.", nameof(nombre));
            if (factorRiesgo < 1 || factorRiesgo > 30)
                throw new ArgumentOutOfRangeException(nameof(factorRiesgo), "El factor de riesgo debe estar entre 1 y 30.");

            this.nombre = nombre.Trim();
            this.factorRiesgo = factorRiesgo;
            this.nivelInestabilidad = Limitar(inestabilidadInicial);
            this.vecesExploradas = 0;
            this.estado = CalcularEstado();
        }

        public void RegistrarExploracion()
        {
            vecesExploradas++;
            AjustarInestabilidad(factorRiesgo);
        }

        public void Estabilizar(int cantidad)
        {
            if (cantidad <= 0) return;
            AjustarInestabilidad(-cantidad);
        }

        public int ObtenerCostoExtraEnergia()
        {
            switch (estado)
            {
                case EstadoRealidad.Inestable: return 5;
                case EstadoRealidad.Critica: return 10;
                default: return 0;
            }
        }

        public int ObtenerPerdidaEstabilidad()
        {
            switch (estado)
            {
                case EstadoRealidad.Inestable: return 5;
                case EstadoRealidad.Critica: return 12;
                default: return 0;
            }
        }

        public int ObtenerCostoViaje()
        {
            return 10 + nivelInestabilidad / 10;
        }

        public string Describir()
        {
            return $"{nombre} | Estado: {estado} | Inestabilidad: {nivelInestabilidad}/{INESTABILIDAD_MAX} | " +
                   $"Riesgo: x{factorRiesgo} | Exploraciones: {vecesExploradas}";
        }

        private void AjustarInestabilidad(int delta)
        {
            nivelInestabilidad = Limitar(nivelInestabilidad + delta);
            EstadoRealidad anterior = estado;
            estado = CalcularEstado();

            if (estado != anterior && EstadoCambiado != null)
                EstadoCambiado(this, anterior, estado);
        }

        private EstadoRealidad CalcularEstado()
        {
            if (nivelInestabilidad >= UMBRAL_CRITICA) return EstadoRealidad.Critica;
            if (nivelInestabilidad >= UMBRAL_INESTABLE) return EstadoRealidad.Inestable;
            return EstadoRealidad.Estable;
        }

        private static int Limitar(int valor)
        {
            if (valor > INESTABILIDAD_MAX) return INESTABILIDAD_MAX;
            if (valor < INESTABILIDAD_MIN) return INESTABILIDAD_MIN;
            return valor;
        }
    }

    // ##########################################################
    //  CONSOLA IRIS (sockets TCP sobre localhost)
    // ##########################################################

    class IrisConsola
    {
        private const int PUERTO = 5050;

        private TcpListener listener;
        private TcpClient clienteEscucha;
        private TcpClient clienteEnvio;
        private StreamWriter escritor;
        private Thread hiloEscucha;

        public bool Activo { get; private set; }

        public void Iniciar()
        {
            try
            {
                listener = new TcpListener(IPAddress.Loopback, PUERTO);
                listener.Start();

                hiloEscucha = new Thread(EscucharMensajes);
                hiloEscucha.IsBackground = true;
                hiloEscucha.Start();

                clienteEnvio = new TcpClient();
                clienteEnvio.Connect(IPAddress.Loopback, PUERTO);
                escritor = new StreamWriter(clienteEnvio.GetStream());
                escritor.AutoFlush = true;

                Activo = true;
            }
            catch (Exception)
            {
                Activo = false;
            }
        }

        private void EscucharMensajes()
        {
            try
            {
                clienteEscucha = listener.AcceptTcpClient();
                using (StreamReader lector = new StreamReader(clienteEscucha.GetStream()))
                {
                    string linea;
                    while ((linea = lector.ReadLine()) != null)
                    {
                        if (linea == "__CERRAR__") break;

                        lock (Program.ConsoleLock)
                        {
                            ConsoleColor original = Console.ForegroundColor;
                            Console.ForegroundColor = ConsoleColor.DarkMagenta;
                            Console.WriteLine($"\n[CONSOLA IRIS] {linea}");
                            Console.ForegroundColor = original;
                        }
                    }
                }
            }
            catch (Exception)
            {
            }
        }

        public void Enviar(string mensaje)
        {
            if (!Activo) return;
            try
            {
                escritor.WriteLine(mensaje);
            }
            catch (Exception)
            {
                Activo = false;
            }
        }

        public void Cerrar()
        {
            try { Enviar("__CERRAR__"); } catch { }
            Thread.Sleep(100); // deja que el hilo escuche termine de imprimir
            try { escritor?.Close(); } catch { }
            try { clienteEnvio?.Close(); } catch { }
            try { clienteEscucha?.Close(); } catch { }
            try { listener?.Stop(); } catch { }
            Activo = false;
        }
    }

