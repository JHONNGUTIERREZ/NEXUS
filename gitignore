        static void MostrarCatalogoRealidades(Explorador e)
        {
            for (int i = 0; i < catalogoRealidades.Count; i++)
            {
                RealidadDimensional r = catalogoRealidades[i];
                string marca = ReferenceEquals(r, e.RealidadActual) ? " <- ubicación actual" : "";
                Console.WriteLine($"  {i + 1}. {r.Describir()} | Costo de viaje: {r.ObtenerCostoViaje()} energía{marca}");
            }
        }

        static void ViajarEntreRealidades(Explorador e)
        {
            Console.WriteLine("\n--- VIAJAR ENTRE REALIDADES ---");
            MostrarCatalogoRealidades(e);
            Console.Write("Elige la realidad destino (0 para cancelar): ");

            string entrada = Console.ReadLine() ?? "";
            int eleccion;
            if (!int.TryParse(entrada, out eleccion) || eleccion < 0 || eleccion > catalogoRealidades.Count)
            {
                EscribirColor("Destino no válido. NEXUS cancela el salto.", ConsoleColor.Yellow);
                return;
            }
            if (eleccion == 0)
            {
                Console.WriteLine("Viaje cancelado.");
                return;
            }

            RealidadDimensional destino = catalogoRealidades[eleccion - 1];

            if (ReferenceEquals(destino, e.RealidadActual))
            {
                Console.WriteLine("Ya te encuentras en esa realidad.");
                return;
            }

            int costo = destino.ObtenerCostoViaje();
            if (e.Energia < costo)
            {
                EscribirColor($"Energía insuficiente para el salto. Se requieren {costo} y tienes {e.Energia}.", ConsoleColor.Yellow);
                return;
            }

            RealidadDimensional origen = e.RealidadActual;

            MostrarEscaneoProgreso($"Calibrando salto dimensional hacia {destino.Nombre}...");
            e.AjustarEnergia(-costo);
            e.CambiarRealidad(destino);
            origen.Estabilizar(5);

            EscribirColor($"Has llegado a {destino.Nombre}. Energía consumida: {costo}.", ConsoleColor.Cyan);
            Console.WriteLine($"Estado de la realidad: {destino.Describir()}");
            iris.Enviar($"NEXUS reporta que el Explorador {e.Nombre} viajó de {origen.Nombre} a {destino.Nombre}.");
        }

        static void ManejarCambioEstadoRealidad(RealidadDimensional r, EstadoRealidad anterior, EstadoRealidad nuevo)
        {
            ConsoleColor color = nuevo == EstadoRealidad.Critica ? ConsoleColor.Red
                               : nuevo == EstadoRealidad.Inestable ? ConsoleColor.Yellow
                               : ConsoleColor.Green;

            EscribirColor($"\n⟳ La realidad {r.Nombre} cambió de estado: {anterior} → {nuevo}", color);
            iris.Enviar($"La realidad {r.Nombre} cambió de estado: {anterior} -> {nuevo}.");
        }

