        static void VerificarCondicionCritica(Explorador e)
        {
            bool comboCritico = e.Energia < 20 && e.Estabilidad < 30;

            int probabilidad = 0;
            if (comboCritico) probabilidad = 70;
            else if (e.Estabilidad < Explorador.ESTABILIDAD_CRITICA) probabilidad = 35;

            if (probabilidad > 0 && rng.Next(1, 101) <= probabilidad)
                e.DispararAnomaliaIris();
        }

        static void VerificarResonanciaEstable(Explorador e)
        {
            if (e.Estabilidad >= Explorador.ESTABILIDAD_RESONANCIA && e.NivelPeligro <= Explorador.PELIGRO_RESONANCIA)
            {
                EscribirColor("\n✦ Resonancia Estable detectada. NEXUS canaliza energía extra al Explorador.", ConsoleColor.Green);
                e.AjustarEnergia(10);
            }
        }

        static void VerificarColapsoDimensional(Explorador e)
        {
            if (e.Estabilidad < Explorador.ESTABILIDAD_COLAPSO && e.NivelPeligro > Explorador.PELIGRO_ALTO)
                e.DispararColapsoDimensional();
        }

