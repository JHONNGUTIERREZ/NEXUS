        static void IniciarJuego(Explorador e)
        {
            e.Inventario.Agregar(Objeto.Crear(TipoObjeto.Celula));
            e.Inventario.Agregar(Objeto.Crear(TipoObjeto.Escudo));
            e.Inventario.Agregar(Objeto.Crear(TipoObjeto.Analizador));

            misionActual = new Mision("La anomalía perdida", 100,
                "Llegar a la zona de anomalía (A)",
                "Encontrar el núcleo energético (N)",
                "Sobrevivir al encuentro con la entidad",
                "Regresar al punto de extracción (S)");

            EscribirColor("\n📋 NUEVA MISIÓN ASIGNADA", ConsoleColor.Cyan);
            misionActual.Mostrar();
            Console.WriteLine("Inventario inicial: célula de energía, escudo y analizador.");
            iris.Enviar($"NEXUS asigna la misión \"{misionActual.Nombre}\" al Explorador {e.Nombre}.");
        }

        static void FinalizarJuego(Explorador e)
        {
            Console.WriteLine("\n──────── RESUMEN DE LA MISIÓN ────────");
            Console.WriteLine(e.Describir());
            Console.WriteLine($"XP total: {e.XP}");
            if (!e.EstaVivo)
                EscribirColor("🔴 MISIÓN FALLIDA: no lograste regresar con vida.", ConsoleColor.Red);
            else if (misionActual != null && misionActual.Completada)
                EscribirColor("🏆 Regresaste con vida y completaste la misión.", ConsoleColor.Green);
            else
                EscribirColor("Regresaste con vida, pero la misión quedó incompleta.", ConsoleColor.Yellow);
        }

        static void ProgresoMision(Explorador e, int indice)
        {
            if (misionActual == null || misionActual.Completada) return;

            if (misionActual.Marcar(indice))
            {
                EscribirColor($"✔ Objetivo cumplido: {misionActual.Objetivos[indice].Descripcion}", ConsoleColor.Green);
                if (misionActual.Completada) EntregarRecompensa(e);
            }
            else if (indice == misionActual.Objetivos.Count - 1 && !misionActual.Objetivos[indice].Completado)
            {
                EscribirColor("NEXUS: llegaste al punto de extracción, pero aún hay objetivos pendientes (opción 8).", ConsoleColor.Yellow);
            }
        }

        static void EntregarRecompensa(Explorador e)
        {
            if (misionActual.RecompensaEntregada) return;
            misionActual.RecompensaEntregada = true;

            EscribirColor("\n🟢 MISIÓN COMPLETADA", ConsoleColor.Green);
            Console.WriteLine($"+{misionActual.RecompensaXP} XP");
            Console.WriteLine("+1 módulo desconocido");

            bool subeNivel = e.GanarXP(misionActual.RecompensaXP);
            e.Inventario.Agregar(Objeto.ModuloDesconocido(), true);

            if (subeNivel)
                EscribirColor($"⬆ ¡Subes al nivel {e.Nivel}! Ataque +2 y vida +15.", ConsoleColor.Cyan);

            iris.Enviar($"MISIÓN COMPLETADA: \"{misionActual.Nombre}\" por el Explorador {e.Nombre}.");
        }

        static void MostrarMision()
        {
            Console.WriteLine("\n--- MISIÓN ACTUAL ---");
            if (misionActual == null) Console.WriteLine("No tienes misión asignada.");
            else misionActual.Mostrar();
        }

        // ================= Inventario (opción 7) =================

        static void GestionarInventario(Explorador e)
        {
            while (true)
            {
                Console.WriteLine("\n--- INVENTARIO ---");
                e.Inventario.Consultar();
                Console.WriteLine("1. Utilizar objeto   2. Eliminar objeto   0. Volver");
                Console.Write("Opción: ");
                string op = (Console.ReadLine() ?? "").Trim();

                try
                {
                    if (op == "0") return;

                    if (op == "1")
                    {
                        Console.Write("Objeto a utilizar (número o nombre): ");
                        Objeto o = e.Inventario.Buscar(Console.ReadLine());
                        EscribirColor(e.Inventario.Utilizar(o, e, null), ConsoleColor.Cyan);
                    }
                    else if (op == "2")
                    {
                        Console.Write("Objeto a eliminar (número o nombre): ");
                        Objeto o = e.Inventario.Buscar(Console.ReadLine());
                        Console.Write($"¿Eliminar todas las unidades de {o.Nombre}? (s/n): ");
                        if ((Console.ReadLine() ?? "").Trim().ToLower() == "s")
                        {
                            string nombre = o.Nombre;
                            e.Inventario.Eliminar(o, o.Cantidad);
                            Console.WriteLine($"{nombre} eliminado del inventario.");
                        }
                        else
                        {
                            Console.WriteLine("Eliminación cancelada.");
                        }
                    }
                    else
                    {
                        throw new OperacionInvalidaException("Opción de inventario no válida. Elige 1, 2 o 0.");
                    }
                }
                catch (OperacionInvalidaException ex)
                {
                    EscribirColor($"⚠ {ex.Message}", ConsoleColor.Yellow);
                }
            }
        }

