    enum TipoObjeto { Celula, Escudo, Modulo, Analizador }

    class Objeto
    {
        public string Nombre { get; }
        public TipoObjeto Tipo { get; }
        public string Icono { get; }
        public int Cantidad { get; set; }

        public Objeto(string nombre, TipoObjeto tipo, string icono, int cantidad = 1)
        {
            Nombre = nombre;
            Tipo = tipo;
            Icono = icono;
            Cantidad = cantidad;
        }

        public static Objeto Crear(TipoObjeto tipo)
        {
            switch (tipo)
            {
                case TipoObjeto.Celula: return new Objeto("Célula de energía", tipo, "🔋");
                case TipoObjeto.Escudo: return new Objeto("Escudo", tipo, "🛡️");
                case TipoObjeto.Modulo: return new Objeto("Módulo de ataque", tipo, "🔫");
                default: return new Objeto("Analizador", TipoObjeto.Analizador, "🔬");
            }
        }

        public static Objeto ModuloDesconocido()
        {
            return new Objeto("Módulo desconocido", TipoObjeto.Modulo, "❓");
        }

        public static Objeto Aleatorio()
        {
            int t = Azar.Rng.Next(1, 101);
            if (t <= 40) return Crear(TipoObjeto.Celula);
            if (t <= 65) return Crear(TipoObjeto.Escudo);
            if (t <= 85) return Crear(TipoObjeto.Modulo);
            return Crear(TipoObjeto.Analizador);
        }
    }

    class Inventario
    {
        public const int CAPACIDAD = 10;
        private readonly List<Objeto> objetos = new List<Objeto>();

        public int Total { get { return objetos.Sum(o => o.Cantidad); } }

        // AGREGAR
        public bool Agregar(Objeto nuevo, bool ignorarLimite = false)
        {
            if (nuevo == null) throw new ArgumentNullException(nameof(nuevo));
            if (!ignorarLimite && Total + nuevo.Cantidad > CAPACIDAD) return false;

            Objeto existente = objetos.FirstOrDefault(o => o.Nombre == nuevo.Nombre);
            if (existente != null) existente.Cantidad += nuevo.Cantidad;
            else objetos.Add(nuevo);
            return true;
        }

        // CONSULTAR
        public void Consultar()
        {
            if (objetos.Count == 0)
            {
                Console.WriteLine("Inventario vacío.");
                return;
            }
            Console.WriteLine($"Inventario ({Total}/{CAPACIDAD}):");
            for (int i = 0; i < objetos.Count; i++)
                Console.WriteLine($"  {i + 1}. {objetos[i].Icono} {objetos[i].Nombre} x{objetos[i].Cantidad}");
        }

        private static string Sin(string s)
        {
            return s.ToLower().Replace('á', 'a').Replace('é', 'e').Replace('í', 'i').Replace('ó', 'o').Replace('ú', 'u');
        }

        // Busca por número o por nombre. Distingue entre "no existe" y "no lo posee".
        public Objeto Buscar(string entrada)
        {
            if (string.IsNullOrWhiteSpace(entrada))
                throw new OperacionInvalidaException("No indicaste ningún objeto.");

            entrada = Sin(entrada.Trim());

            int indice;
            if (int.TryParse(entrada, out indice))
            {
                if (indice < 1 || indice > objetos.Count)
                    throw new OperacionInvalidaException($"No existe el objeto número {indice} en tu inventario.");
                return objetos[indice - 1];
            }

            Objeto encontrado = objetos.FirstOrDefault(o => Sin(o.Nombre).Contains(entrada));
            if (encontrado != null) return encontrado;

            string[] conocidos = { "celula", "energia", "escudo", "modulo", "ataque", "analizador" };
            if (conocidos.Any(k => k.Contains(entrada) || entrada.Contains(k)))
                throw new OperacionInvalidaException($"No posees ningún objeto llamado '{entrada}'.");

            throw new OperacionInvalidaException($"El objeto '{entrada}' no existe en NEXUS.");
        }

        // UTILIZAR (consume una unidad). Si hay objetivo, el Analizador lo analiza.
        public string Utilizar(Objeto objeto, Explorador e, Personaje objetivo)
        {
            if (objeto == null || !objetos.Contains(objeto))
                throw new OperacionInvalidaException("Ese objeto no está en tu inventario.");

            string resultado;
            switch (objeto.Tipo)
            {
                case TipoObjeto.Celula:
                    {
                        int antes = e.Energia;
                        e.AjustarEnergia(25);
                        resultado = $"{objeto.Icono} {objeto.Nombre} utilizada. Energía: {antes} → {e.Energia}";
                        break;
                    }
                case TipoObjeto.Escudo:
                    {
                        e.ActivarEscudo(30);
                        resultado = $"{objeto.Icono} Escudo activado: absorberá 30 de daño. (Escudo total: {e.Escudo})";
                        break;
                    }
                case TipoObjeto.Modulo:
                    {
                        int bono = objeto.Nombre.Contains("desconocido") ? 25 : 15;
                        e.ActivarBono(bono);
                        resultado = $"{objeto.Icono} {objeto.Nombre} acoplado: tu próximo ataque hace +{bono} de daño.";
                        break;
                    }
                default:
                    {
                        if (objetivo != null)
                        {
                            objetivo.Analizado = true;
                            resultado = $"{objeto.Icono} Análisis completo: {objetivo.Describir()}";
                        }
                        else if (Azar.Rng.Next(1, 101) <= 50)
                        {
                            e.RegistrarFragmento();
                            resultado = $"{objeto.Icono} El analizador recupera un fragmento de información sobre IRIS.";
                        }
                        else
                        {
                            resultado = $"{objeto.Icono} El analizador escanea la zona y no encuentra nada relevante.";
                        }
                        break;
                    }
            }

            Eliminar(objeto, 1);
            return resultado;
        }

        // ELIMINAR (quita unidades; si llega a 0 desaparece del inventario)
        public void Eliminar(Objeto objeto, int cantidad)
        {
            if (objeto == null || !objetos.Contains(objeto))
                throw new OperacionInvalidaException("Ese objeto no está en tu inventario.");
            objeto.Cantidad -= Math.Max(1, cantidad);
            if (objeto.Cantidad <= 0) objetos.Remove(objeto);
        }
    }

    // ##########################################################
    //  SISTEMA DE MISIONES
    // ##########################################################

    class Objetivo
    {
        public string Descripcion { get; }
        public bool Completado { get; set; }
        public Objetivo(string descripcion) { Descripcion = descripcion; }
    }

    class Mision
    {
        public string Nombre { get; }
        public int RecompensaXP { get; }
        public bool RecompensaEntregada { get; set; }
        public List<Objetivo> Objetivos { get; } = new List<Objetivo>();
        public bool Completada { get { return Objetivos.All(o => o.Completado); } }

        public Mision(string nombre, int xp, params string[] objetivos)
        {
            Nombre = nombre;
            RecompensaXP = xp;
            foreach (string o in objetivos) Objetivos.Add(new Objetivo(o));
        }

        // El último objetivo (extracción) exige haber cumplido los anteriores.
        public bool Marcar(int indice)
        {
            if (indice < 0 || indice >= Objetivos.Count) return false;
            if (Objetivos[indice].Completado) return false;
            if (indice == Objetivos.Count - 1 && Objetivos.Take(indice).Any(o => !o.Completado)) return false;
            Objetivos[indice].Completado = true;
            return true;
        }

        public void Mostrar()
        {
            Console.WriteLine($"Misión: \"{Nombre}\"");
            foreach (Objetivo o in Objetivos)
                Console.WriteLine($"  {(o.Completado ? "☑" : "☐")} {o.Descripcion}");
        }
    }

