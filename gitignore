        // ================= Eventos de exploración =================

        static void ResolverEventoZona(Explorador e)
        {
            int t = rng.Next(1, 101);

            if (t <= 20)
            {
                EncontrarObjeto(e);
            }
            else if (t <= 45)
            {
                Encuentro(e);
            }
            else if (t <= 60)
            {
                EscribirColor("\n⚡ ANOMALÍA DETECTADA: la zona vibra. Estabilidad -8, peligro +8.", ConsoleColor.Magenta);
                e.AjustarEstabilidad(-8);
                e.AjustarPeligro(8);
                if (rng.Next(1, 101) <= 30)
                {
                    EscribirColor("Entre la distorsión recuperas un fragmento de información sobre IRIS.", ConsoleColor.Cyan);
                    e.RegistrarFragmento();
                }
            }
            else if (t <= 72)
            {
                EscribirColor("\n🔋 PÉRDIDA DE ENERGÍA: una fuga drena tus reservas (-10).", ConsoleColor.Yellow);
                e.AjustarEnergia(-10);
            }
            else if (t <= 82)
            {
                EscribirColor("\n🚨 SISTEMA DAÑADO: tu traje sufre una sobrecarga.", ConsoleColor.Red);
                if (e.Escudo > 0)
                {
                    e.DesactivarEscudo();
                    Console.WriteLine("Tu escudo se desintegra.");
                }
                e.AjustarEstabilidad(-10);
                Console.WriteLine("Estabilidad -10.");
            }
            else if (t <= 92)
            {
                string[] pistas =
                {
                    "Un eco dice que IRIS observa a los Exploradores desde dentro.",
                    "Una inscripción indica que el núcleo energético brilla cerca de la anomalía.",
                    "Los registros sugieren que los robots son vulnerables al ser analizados."
                };
                EscribirColor($"\n📡 INFORMACIÓN ENCONTRADA: {pistas[rng.Next(pistas.Length)]}", ConsoleColor.Cyan);
                e.GanarXP(5);
            }
            else
            {
                Console.WriteLine("\nLa zona está en calma. No encuentras nada.");
            }
        }

        static void EncontrarObjeto(Explorador e)
        {
            Objeto o = Objeto.Aleatorio();
            EscribirColor($"\n🎁 OBJETO ENCONTRADO: {o.Icono} {o.Nombre}", ConsoleColor.Green);
            if (e.Inventario.Agregar(o))
                Console.WriteLine("Guardado en tu inventario.");
            else
                EscribirColor("Inventario lleno: debes dejarlo atrás. Libera espacio con la opción 7.", ConsoleColor.Yellow);
        }

        // ================= Sistema de encuentros =================

        static Personaje GenerarEntidad()
        {
            if (rng.Next(1, 101) <= 40)
            {
                string[] robots = { "Centinela-7", "Vigía Mecánico", "Dron Custodio" };
                return new Robot(robots[rng.Next(robots.Length)]);
            }
            string[] enemigos = { "Sombra de Eco", "Devorador de Fase", "Larva Dimensional" };
            return new Enemigo(enemigos[rng.Next(enemigos.Length)], rng.Next(30, 51), rng.Next(8, 13));
        }

        static void Encuentro(Explorador e)
        {
            Personaje ent = GenerarEntidad();
            entidadActual = ent;
            string tipo = ent is Robot ? "Robot" : "Enemigo";

            EscribirColor($"\n👾 ENTIDAD DETECTADA: {ent.Nombre} ({tipo})", ConsoleColor.Red);
            iris.Enviar($"ENTIDAD DETECTADA ({tipo}: {ent.Nombre}) cerca del Explorador {e.Nombre}.");

            bool escapo = false;

            while (!escapo && ent.EstaVivo && e.EstaVivo)
            {
                string vidaEnt = ent.Analizado ? $"{ent.Vida}/{ent.VidaMax}" : "???";
                Console.WriteLine($"\nVida: {e.Vida}/{e.VidaMax} | Escudo: {e.Escudo} | Energía: {e.Energia} || {ent.Nombre}: {vidaEnt}");
                Console.WriteLine("1. Atacar   2. Escapar   3. Utilizar objeto   4. Analizar");
                Console.Write("Acción: ");
                string op = (Console.ReadLine() ?? "").Trim();

                bool turnoGastado = false;

                try
                {
                    switch (op)
                    {
                        case "1":
                            {
                                int dano = e.CalcularAtaque();
                                int real = ent.RecibirDano(dano);
                                Console.WriteLine($"⚔ Atacas a {ent.Nombre}: -{real} vida.");
                                turnoGastado = true;
                                break;
                            }
                        case "2":
                            {
                                escapo = IntentarEscapar(e, ent);
                                turnoGastado = true;
                                break;
                            }
                        case "3":
                            {
                                Console.WriteLine();
                                e.Inventario.Consultar();
                                Console.Write("Objeto a utilizar (número o nombre, vacío para cancelar): ");
                                string seleccion = Console.ReadLine() ?? "";
                                if (string.IsNullOrWhiteSpace(seleccion)) break;
                                Objeto objeto = e.Inventario.Buscar(seleccion);
                                EscribirColor(e.Inventario.Utilizar(objeto, e, ent), ConsoleColor.Cyan);
                                turnoGastado = true;
                                break;
                            }
                        case "4":
                            {
                                if (ent.Analizado)
                                    throw new OperacionInvalidaException("Ya analizaste a esta entidad.");
                                if (e.Energia < 5)
                                    throw new OperacionInvalidaException("Energía insuficiente para analizar (mínimo 5).");
                                e.AjustarEnergia(-5);
                                ent.Analizado = true;
                                EscribirColor($"🔬 Análisis completado (-5 energía): {ent.Describir()}", ConsoleColor.Cyan);
                                turnoGastado = true;
                                break;
                            }
                        default:
                            throw new OperacionInvalidaException("Acción no válida. Elige 1, 2, 3 o 4.");
                    }
                }
                catch (OperacionInvalidaException ex)
                {
                    EscribirColor($"⚠ {ex.Message}", ConsoleColor.Yellow);
                    continue; // no se pierde el turno
                }

                // El Enemigo contraataca siempre; el Robot solo activa su
                // sistema defensivo cuando se le ataca o se intenta huir.
                bool reacciona = ent is Enemigo || op == "1" || op == "2";
                if (!escapo && ent.EstaVivo && turnoGastado && reacciona)
                    Console.WriteLine(ent.Reaccionar(e));
            }

            entidadActual = null;

            if (!e.EstaVivo)
            {
                EscribirColor("\n💀 Tu señal vital se extingue. NEXUS fuerza la desconexión.", ConsoleColor.Red);
                iris.Enviar($"El Explorador {e.Nombre} fue derrotado por {ent.Nombre}.");
                e.Conectado = false;
                return;
            }

            if (!ent.EstaVivo)
            {
                EscribirColor($"\n✔ {ent.Nombre} ha sido neutralizado.", ConsoleColor.Green);
                int xp = ent is Robot ? 30 : 40;
                Console.WriteLine($"+{xp} XP");
                if (e.GanarXP(xp))
                    EscribirColor($"⬆ ¡Subes al nivel {e.Nivel}! Ataque +2 y vida +15.", ConsoleColor.Cyan);
                if (rng.Next(1, 101) <= 60) EncontrarObjeto(e);
            }

            // Sobrevivió al encuentro (venciendo o escapando).
            ProgresoMision(e, 2);
        }

        static bool IntentarEscapar(Explorador e, Personaje ent)
        {
            if (e.Energia < 5)
            {
                EscribirColor("Sin energía para huir (mínimo 5). La entidad te alcanza.", ConsoleColor.Yellow);
                return false;
            }

            e.AjustarEnergia(-5);
            int probabilidad = ent is Robot ? 70 : 50;

            if (rng.Next(1, 101) <= probabilidad)
            {
                EscribirColor("💨 Logras escapar de la entidad (-5 energía).", ConsoleColor.Green);
                return true;
            }

            EscribirColor("No logras escapar (-5 energía).", ConsoleColor.Yellow);
            return false;
        }

