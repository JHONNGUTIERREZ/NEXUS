        static void ExplorarRealidad(Explorador e)
        {
            Console.WriteLine("\n--- EXPLORAR REALIDAD ---");

            if (e.Energia < Explorador.ENERGIA_MIN_EXPLORAR)
            {
                EscribirColor($"⚠ Energía insuficiente. Necesitas al menos {Explorador.ENERGIA_MIN_EXPLORAR} de energía para explorar.", ConsoleColor.Yellow);
                Console.WriteLine("NEXUS sugiere usar la opción 4 (o una célula de energía) para recuperar energía.");
                return;
            }

            if (e.NivelPeligro >= Explorador.PELIGRO_ALTO)
            {
                EscribirColor("\n⚠ ADVERTENCIA: el nivel de peligro es alto. Explorar ahora es arriesgado.", ConsoleColor.Yellow);
                Console.Write("¿Deseas continuar de todos modos? (s/n): ");
                string respuesta = (Console.ReadLine() ?? "").Trim().ToLower();
                if (respuesta != "s")
                {
                    Console.WriteLine("Exploración cancelada. NEXUS mantiene la posición actual.");
                    return;
                }
            }

            MostrarEscaneoProgreso("Escaneando la realidad...");

            // Fase 1: recorrido del sector (matriz, encuentros y eventos).
            ExplorarMapa(e);

            if (!e.Conectado) return; // murió o fue desconectado durante el recorrido

            if (e.Energia <= 0)
            {
                EscribirColor("\nTe has quedado sin energía. NEXUS interrumpe la exploración.", ConsoleColor.Red);
                return;
            }

            // Fase 2: desenlace general de la expedición.
            int costoEnergia = rng.Next(15, 26);
            int cambioEstabilidad = rng.Next(-15, 6);

            e.AjustarEnergia(-costoEnergia);
            e.AjustarEstabilidad(cambioEstabilidad);

            Console.WriteLine($"\nHas explorado una zona desconocida de {e.Realidad}.");
            Console.WriteLine($"Energía consumida: {costoEnergia}");

            if (e.Energia >= 70 && e.Estabilidad >= 70)
            {
                EscribirColor("La sincronía con la realidad es excelente. Exploración óptima.", ConsoleColor.Green);
                e.AjustarPeligro(-5);
            }
            else if (e.Energia < 30 || e.Estabilidad < 30)
            {
                if (e.Estabilidad < Explorador.ESTABILIDAD_CRITICA)
                {
                    EscribirColor("La conexión se sacude violentamente. Zona extremadamente inestable.", ConsoleColor.Red);
                    e.AjustarPeligro(20);
                }
                else
                {
                    EscribirColor("La exploración fue tensa. La zona no es del todo segura.", ConsoleColor.Yellow);
                    e.AjustarPeligro(10);
                }
            }
            else
            {
                Console.WriteLine(cambioEstabilidad >= 0
                    ? $"La conexión se sintió estable. Estabilidad +{cambioEstabilidad}"
                    : $"La conexión sufrió turbulencias. Estabilidad {cambioEstabilidad}");
            }

            // Fase 3: la realidad (objeto) reacciona y cobra su costo.
            AplicarEfectosDeRealidad(e);
        }

        static void AplicarEfectosDeRealidad(Explorador e)
        {
            RealidadDimensional r = e.RealidadActual;

            r.RegistrarExploracion();

            int extraEnergia = r.ObtenerCostoExtraEnergia();
            int perdidaEstabilidad = r.ObtenerPerdidaEstabilidad();

            if (extraEnergia > 0 || perdidaEstabilidad > 0)
            {
                EscribirColor($"\n{r.Nombre} se encuentra {r.Estado.ToString().ToUpper()}: " +
                              $"-{extraEnergia} energía, -{perdidaEstabilidad} estabilidad.", ConsoleColor.Yellow);
                e.AjustarEnergia(-extraEnergia);
                e.AjustarEstabilidad(-perdidaEstabilidad);
            }

            Console.WriteLine($"Estado de la realidad: {r.Describir()}");
        }

        static void AnalizarAnomalia(Explorador e)
        {
            Console.WriteLine("\n--- ANALIZAR ANOMALÍA ---");

            if (e.Energia < Explorador.ENERGIA_MIN_ANALIZAR)
            {
                EscribirColor($"⚠ No tienes suficiente energía para analizar anomalías (mínimo {Explorador.ENERGIA_MIN_ANALIZAR}).", ConsoleColor.Yellow);
                return;
            }

            e.AjustarEnergia(-10);

            if (e.Estabilidad < 20)
            {
                Console.WriteLine("NEXUS fuerza un análisis profundo pese a la inestabilidad de la conexión...");
                e.AjustarPeligro(15);
                if (rng.Next(1, 101) <= 85)
                {
                    EscribirColor("Análisis inestable: se ha recuperado un fragmento de información sobre IRIS.", ConsoleColor.Cyan);
                    e.RegistrarFragmento();
                }
                else
                {
                    Console.WriteLine("El análisis colapsó antes de arrojar resultados.");
                }
            }
            else if (e.Estabilidad < 60)
            {
                Console.WriteLine("NEXUS detecta un patrón inusual en la anomalía...");
                if (rng.Next(1, 101) <= 40)
                {
                    EscribirColor("Se ha recuperado un fragmento de información sobre IRIS.", ConsoleColor.Cyan);
                    e.RegistrarFragmento();
                }
                else
                {
                    Console.WriteLine("El análisis no arrojó resultados relevantes esta vez.");
                }
            }
            else
            {
                Console.WriteLine("La conexión es estable. NEXUS realiza un análisis limpio y seguro.");
                e.AjustarEstabilidad(2);
                EscribirColor("Se ha recuperado un fragmento de información sobre IRIS.", ConsoleColor.Cyan);
                e.RegistrarFragmento();
