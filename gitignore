    class Explorador : Cadete
    {
        public const int EDAD_MINIMA = 15;

        public const int ENERGIA_MIN_INGRESO = 30;
        public const int ESTABILIDAD_MIN_INGRESO = 40;

        public const int ENERGIA_MIN_EXPLORAR = 25;
        public const int ENERGIA_MIN_ANALIZAR = 15;

        public const int ESTABILIDAD_CRITICA = 20;

        public const int VALOR_MAXIMO = 100;
        public const int VALOR_MINIMO = 0;

        public const int PELIGRO_ALTO = 60;
        public const int ESTABILIDAD_COLAPSO = 25;
        public const int ESTABILIDAD_RESONANCIA = 80;
        public const int PELIGRO_RESONANCIA = 10;
        public const int FRAGMENTOS_PARA_PROTOCOLO = 3;

        public int Edad { get; }

        public RealidadDimensional RealidadActual { get; private set; }
        public string Realidad { get { return RealidadActual.Nombre; } }
        public int ViajesRealizados { get; private set; }

        public int Energia { get; private set; }
        public int Estabilidad { get; private set; }
        public bool Conectado { get; set; }

        public int NivelPeligro { get; private set; }
        public int FragmentosRecuperados { get; private set; }
        public bool ProtocoloDescubierto { get; private set; }

        public event Action<Explorador> AnomaliaDetectada;
        public event Action<Explorador> ColapsoDetectado;

        public Explorador(string nombre, int edad, RealidadDimensional realidad, int energia, int estabilidad)
            : base(nombre, 100, 12)
        {
            if (realidad == null)
                throw new ArgumentNullException(nameof(realidad));

            Edad = edad;
            RealidadActual = realidad;
            Energia = energia;
            Estabilidad = estabilidad;
            Conectado = true;
        }

        public void CambiarRealidad(RealidadDimensional destino)
        {
            if (destino == null)
                throw new ArgumentNullException(nameof(destino));

            RealidadActual = destino;
            ViajesRealizados++;
        }

        private static int Limitar(int valor)
        {
            if (valor > VALOR_MAXIMO) return VALOR_MAXIMO;
            if (valor < VALOR_MINIMO) return VALOR_MINIMO;
            return valor;
        }

        public void AjustarEnergia(int delta) { Energia = Limitar(Energia + delta); }
        public void AjustarEstabilidad(int delta) { Estabilidad = Limitar(Estabilidad + delta); }
        public void AjustarPeligro(int delta) { NivelPeligro = Limitar(NivelPeligro + delta); }

        public void RegistrarFragmento()
        {
            FragmentosRecuperados++;
            if (FragmentosRecuperados >= FRAGMENTOS_PARA_PROTOCOLO)
                ProtocoloDescubierto = true;
        }

        public void DispararAnomaliaIris()
        {
            if (AnomaliaDetectada != null) AnomaliaDetectada(this);
        }

        public void DispararColapsoDimensional()
        {
            if (ColapsoDetectado != null) ColapsoDetectado(this);
        }
    }

    // ##########################################################
    //  PROGRAMA PRINCIPAL
    // ##########################################################

    class Program
    {
        static Random rng = Azar.Rng;

        static int advertenciasCriticas = 0;
        static int colapsosDetectados = 0;

        public static readonly object ConsoleLock = new object();

        static IrisConsola iris = new IrisConsola();
        static List<RealidadDimensional> catalogoRealidades = new List<RealidadDimensional>();

        static Mision misionActual;
        static Personaje entidadActual; // null cuando no hay ninguna entidad cerca

        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            MostrarBienvenida();

            iris.Iniciar();
            if (iris.Activo)
                EscribirColor("Canal con la CONSOLA IRIS establecido (sockets TCP, localhost).\n", ConsoleColor.DarkMagenta);
            else
                EscribirColor("No se pudo establecer el canal con la CONSOLA IRIS. NEXUS continúa sin notificaciones remotas.\n", ConsoleColor.DarkGray);

            // ---------- Registro del cadete ----------
            string nombre = LeerTexto("Nombre del Explorador: ");
            int edad = LeerEnteroEnRango("Edad: ", 1, 120);
            string nombreRealidad = LeerTexto("Realidad asignada: ");
            int energiaInicial = LeerEnteroEnRango("Nivel de energía inicial (0-100): ", 0, 100);
            int estabilidadInicial = LeerEnteroEnRango("Nivel de estabilidad de conexión inicial (0-100): ", 0, 100);

            // ---------- Realidades ----------
            RealidadDimensional realidadAsignada = new RealidadDimensional(nombreRealidad, 10, 6);
            RealidadDimensional nexoFracturado = new RealidadDimensional("Nexo Fracturado", 45, 12);
            RealidadDimensional jardinEco = new RealidadDimensional("Jardín de Eco", 5, 3);

            catalogoRealidades.Add(realidadAsignada);
            catalogoRealidades.Add(nexoFracturado);
            catalogoRealidades.Add(jardinEco);

            foreach (RealidadDimensional r in catalogoRealidades)
                r.EstadoCambiado += ManejarCambioEstadoRealidad;

            Explorador explorador = new Explorador(nombre, edad, realidadAsignada, energiaInicial, estabilidadInicial);
            explorador.AnomaliaDetectada += ManejarAlertaIris;
            explorador.ColapsoDetectado += ManejarColapsoDimensional;

            // ---------- Autorización ----------
            if (!EvaluarAutorizacion(explorador))
            {
                Console.WriteLine("\nNEXUS no puede autorizar el inicio de la inmersión en este momento.");
                Console.WriteLine("Vuelve a intentarlo cuando cumplas los requisitos mínimos.\n");
                iris.Cerrar();
                return;
            }

            Console.WriteLine($"\n✓ Autorización concedida, Explorador {explorador.Nombre}.");
            Console.WriteLine($"Iniciando conexión con la realidad: {explorador.Realidad}...\n");
            iris.Enviar($"NEXUS reporta ingreso autorizado del Explorador {explorador.Nombre} a la realidad {explorador.Realidad}.");

            Console.WriteLine("NEXUS registra las siguientes realidades en su catálogo:");
            MostrarCatalogoRealidades(explorador);

            IniciarJuego(explorador);

            // ---------- Ciclo principal ----------
            while (explorador.Conectado)
            {
                MostrarMenu(explorador);

                try
                {
                    int opcion = LeerEntero("Seleccione una operación: ");

                    if (opcion < 1 || opcion > 9)
                        throw new OperacionInvalidaException($"La operación {opcion} no existe en el sistema NEXUS.");

                    switch (opcion)
                    {
                        case 1: ExplorarRealidad(explorador); break;
                        case 2: AnalizarAnomalia(explorador); break;
                        case 3: ConsultarEstado(explorador); break;
                        case 4: RecuperarEnergia(explorador); break;
                        case 5: IntentarDesconexion(explorador); break;
                        case 6: ViajarEntreRealidades(explorador); break;
                        case 7: GestionarInventario(explorador); break;
                        case 8: MostrarMision(); break;
                        case 9: AtacarFueraDeEncuentro(); break;
                    }
                }
                catch (OperacionInvalidaException ex)
                {
                    EscribirColor($"\n⚠ {ex.Message} Elige una opción entre 1 y 9.\n", ConsoleColor.Yellow);
                }
                catch (Exception ex)
                {
                    EscribirColor($"\n⚠ NEXUS detectó un error inesperado: {ex.Message}\n", ConsoleColor.Red);
                }

                if (explorador.Conectado)
                {
                    VerificarResonanciaEstable(explorador);
                    VerificarCondicionCritica(explorador);
                    VerificarColapsoDimensional(explorador);
                }
            }

            FinalizarJuego(explorador);

            iris.Enviar($"NEXUS reporta cierre de sesión del Explorador {explorador.Nombre}.");
            iris.Cerrar();

            Console.WriteLine("\n════════════════════════════════════════");
            Console.WriteLine("   SESIÓN FINALIZADA - ENLACE CERRADO");
            Console.WriteLine("════════════════════════════════════════\n");
        }

