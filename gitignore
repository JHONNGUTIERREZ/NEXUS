        // ================= Mapas (matrices) =================
        //   .  vacío (puede producir eventos)
        //   #  obstáculo
        //   $  depósito de energía
        //   ~  zona de inestabilidad dimensional
        //   A  anomalía (custodiada por una entidad)
        //   N  núcleo energético (objetivo de misión)
        //   S  punto de salida / extracción
        // ====================================================

        static char[,] ObtenerMapa(string realidad)
        {
            string[][] plantillas = new string[][]
            {
                new string[] { "........", "..##..$.", "..#A..#.", "....~..#", "..#...S.", "........" },
                new string[] { "..$.....", ".###..~.", "....A..#", "..~..##.", ".#....S.", "........" },
                new string[] { "....#...", ".$..#.~.", "..A....#", ".##..#..", "....S...", "...~...." }
            };

            // Hash determinista (GetHashCode de string varía entre ejecuciones).
            int hash = 0;
            foreach (char ch in realidad) hash = (hash * 31 + ch) & 0x7FFFFFFF;

            string[] plantilla = plantillas[hash % plantillas.Length];
            int filas = plantilla.Length;
            int columnas = plantilla[0].Length;
            char[,] mapa = new char[filas, columnas];

            for (int f = 0; f < filas; f++)
                for (int c = 0; c < columnas; c++)
                    mapa[f, c] = plantilla[f][c];

            return mapa;
        }

        // Coloca el núcleo energético (N) mientras ese objetivo siga pendiente.
        static void ColocarNucleo(char[,] mapa)
        {
            if (misionActual == null || misionActual.Objetivos[1].Completado) return;

            for (int f = 2; f < mapa.GetLength(0); f++)
                for (int c = 3; c < mapa.GetLength(1); c++)
                    if (mapa[f, c] == '.')
                    {
                        mapa[f, c] = 'N';
                        return;
                    }
        }

        static void DibujarMapa(char[,] mapa, int filaJugador, int colJugador)
        {
            int filas = mapa.GetLength(0);
            int columnas = mapa.GetLength(1);

            Console.WriteLine();
            for (int f = 0; f < filas; f++)
            {
                for (int c = 0; c < columnas; c++)
                {
                    if (f == filaJugador && c == colJugador)
                    {
                        EscribirColor("J", ConsoleColor.Cyan, salto: false);
                        continue;
                    }

                    char casilla = mapa[f, c];
                    ConsoleColor color = ConsoleColor.Gray;

                    if (casilla == '#') color = ConsoleColor.DarkGray;
                    else if (casilla == '$') color = ConsoleColor.Green;
                    else if (casilla == '~') color = ConsoleColor.Yellow;
                    else if (casilla == 'A') color = ConsoleColor.Magenta;
                    else if (casilla == 'N') color = ConsoleColor.DarkYellow;
                    else if (casilla == 'S') color = ConsoleColor.Cyan;

                    EscribirColor(casilla.ToString(), color, salto: false);
                }
                Console.WriteLine();
            }
            Console.WriteLine();
        }

        static void ExplorarMapa(Explorador e)
        {
            char[,] mapa = ObtenerMapa(e.Realidad);
            ColocarNucleo(mapa);

            int filas = mapa.GetLength(0);
            int columnas = mapa.GetLength(1);

            int filaJugador = 0;
            int colJugador = 0;

            for (int f = 0; f < filas; f++)
            {
                if (mapa[f, 0] != '#')
                {
                    filaJugador = f;
                    break;
                }
            }

            int movimientosRestantes = e.Energia >= 70 ? 14 : 12;
            bool salioPorSalida = false;

            Console.WriteLine("\nTe internas en el sector explorable de la realidad.");
            Console.WriteLine("Muévete con W (arriba) / A (izquierda) / S (abajo) / D (derecha). Q para retirarte.");
            Console.WriteLine("Leyenda: A anomalía | N núcleo | S extracción | $ energía | ~ inestable | # obstáculo");

            while (movimientosRestantes > 0 && e.Energia > 0 && e.Conectado)
            {
                DibujarMapa(mapa, filaJugador, colJugador);
                Console.WriteLine($"Movimientos restantes: {movimientosRestantes} | Energía: {e.Energia} | Estabilidad: {e.Estabilidad} | Vida: {e.Vida}");
                Console.Write("Movimiento (W/A/S/D/Q): ");
                string tecla = (Console.ReadLine() ?? "").Trim().ToLower();

                int nuevaFila = filaJugador;
                int nuevaCol = colJugador;

                if (tecla == "w") nuevaFila--;
                else if (tecla == "s") nuevaFila++;
                else if (tecla == "a") nuevaCol--;
                else if (tecla == "d") nuevaCol++;
                else if (tecla == "q")
                {
                    Console.WriteLine("Te retiras del sector explorado.");
                    break;
                }
                else
                {
                    Console.WriteLine("Movimiento no reconocido. Usa W, A, S, D o Q.");
                    continue;
                }

                if (nuevaFila < 0 || nuevaFila >= filas || nuevaCol < 0 || nuevaCol >= columnas)
                {
                    Console.WriteLine("No puedes salir de los límites del sector explorado.");
                    continue;
                }

                if (mapa[nuevaFila, nuevaCol] == '#')
                {
                    Console.WriteLine("Un obstáculo dimensional bloquea el paso.");
                    continue;
                }

                filaJugador = nuevaFila;
                colJugador = nuevaCol;
                movimientosRestantes--;

                char casilla = mapa[filaJugador, colJugador];

                if (casilla == '$')
                {
                    EscribirColor("Encuentras un depósito de energía residual.", ConsoleColor.Green);
                    e.AjustarEnergia(15);
                    mapa[filaJugador, colJugador] = '.';
                }
                else if (casilla == '~')
                {
                    EscribirColor("Pisas una zona de inestabilidad dimensional.", ConsoleColor.Yellow);
                    e.AjustarEstabilidad(-10);
                    e.AjustarPeligro(10);
                }
                else if (casilla == 'A')
                {
                    Console.WriteLine("Detectas una anomalía en esta casilla.");
                    ProgresoMision(e, 0);
                    Console.WriteLine("Algo custodia la anomalía...");
                    Encuentro(e);
                    if (!e.Conectado) break;

                    if (rng.Next(1, 101) <= 50)
                    {
                        EscribirColor("Se ha recuperado un fragmento de información sobre IRIS.", ConsoleColor.Cyan);
                        e.RegistrarFragmento();
                    }
                    mapa[filaJugador, colJugador] = '.';
                }
                else if (casilla == 'N')
                {
                    EscribirColor("⚡ Encuentras el núcleo energético. Su energía te recorre (+10).", ConsoleColor.Yellow);
                    e.AjustarEnergia(10);
                    mapa[filaJugador, colJugador] = '.';
                    ProgresoMision(e, 1);
                }
                else if (casilla == 'S')
                {
                    EscribirColor("Alcanzas un punto de salida estable. El recorrido concluye.", ConsoleColor.Green);
                    e.AjustarEstabilidad(10);
                    ProgresoMision(e, 3);
                    salioPorSalida = true;
                    break;
                }
                else if (casilla == '.')
                {
                    // Casilla vacía: puede producir un evento de exploración.
                    if (rng.Next(1, 101) <= 25) ResolverEventoZona(e);
                    if (!e.Conectado) break;
                }
            }

            if (!salioPorSalida && movimientosRestantes == 0)
                Console.WriteLine("Se agotó el margen de movimientos en este sector.");
        }

