    abstract class Personaje
    {
        public string Nombre { get; }
        public int VidaMax { get; }
        public int Vida { get; protected set; }
        public int Ataque { get; protected set; }
        public bool Analizado { get; set; }
        public bool EstaVivo { get { return Vida > 0; } }

        protected Personaje(string nombre, int vida, int ataque)
        {
            Nombre = nombre;
            VidaMax = vida;
            Vida = vida;
            Ataque = ataque;
        }

        public virtual int RecibirDano(int dano)
        {
            if (dano < 0) dano = 0;
            int real = Math.Min(dano, Vida);
            Vida -= real;
            return real;
        }

        public void Curar(int cantidad)
        {
            Vida = Math.Min(VidaMax, Vida + Math.Max(0, cantidad));
        }

        public abstract string Describir();

        // Cómo responde el personaje cuando le toca actuar contra el Cadete.
        public abstract string Reaccionar(Explorador cadete);
    }

    class Cadete : Personaje
    {
        public int XP { get; private set; }
        public int Nivel { get { return XP / 100 + 1; } }
        public int Escudo { get; private set; }
        public int BonoAtaque { get; private set; }
        public Inventario Inventario { get; } = new Inventario();

        public Cadete(string nombre, int vida, int ataque) : base(nombre, vida, ataque) { }

        // El escudo absorbe daño antes que la vida.
        public override int RecibirDano(int dano)
        {
            if (dano < 0) dano = 0;
            if (Escudo > 0)
            {
                int absorbido = Math.Min(Escudo, dano);
                Escudo -= absorbido;
                dano -= absorbido;
            }
            return base.RecibirDano(dano);
        }

        public void ActivarEscudo(int puntos) { Escudo += puntos; }
        public void DesactivarEscudo() { Escudo = 0; }
        public void ActivarBono(int bono) { BonoAtaque = bono; }

        // El módulo de ataque se consume en el siguiente golpe.
        public int CalcularAtaque()
        {
            int dano = Ataque + BonoAtaque + Azar.Rng.Next(-2, 4);
            BonoAtaque = 0;
            return Math.Max(1, dano);
        }

        public bool GanarXP(int cantidad)
        {
            int antes = Nivel;
            XP += cantidad;
            if (Nivel > antes)
            {
                Ataque += 2;
                Curar(15);
                return true;
            }
            return false;
        }

        public override string Describir()
        {
            return $"Cadete {Nombre} | Nivel {Nivel} | Vida {Vida}/{VidaMax} | Ataque {Ataque}";
        }

        public override string Reaccionar(Explorador cadete) { return ""; }
    }

    class Robot : Personaje
    {
        public Robot(string nombre) : base(nombre, 40, 6) { }

        // Blindaje: reduce 40% del daño, salvo que su punto débil esté expuesto.
        public override int RecibirDano(int dano)
        {
            if (!Analizado) dano = dano * 6 / 10;
            return base.RecibirDano(dano);
        }

        // Sistema defensivo: pulso EMP que drena energía y daña.
        public override string Reaccionar(Explorador cadete)
        {
            cadete.AjustarEnergia(-8);
            int dano = cadete.RecibirDano(Ataque + 2);
            return $"🤖 {Nombre} activa su SISTEMA DEFENSIVO: pulso EMP. -8 energía, -{dano} vida.";
        }

        public override string Describir()
        {
            if (!Analizado) return $"Robot {Nombre} | Datos incompletos (analiza para ver su punto débil)";
            return $"Robot {Nombre} | Vida {Vida}/{VidaMax} | Ataque {Ataque} | Blindaje desactivado: punto débil expuesto";
        }
    }

    class Enemigo : Personaje
    {
        public Enemigo(string nombre, int vida, int ataque) : base(nombre, vida, ataque) { }

        // Si se analiza se descubre su debilidad (+50% de daño recibido).
        public override int RecibirDano(int dano)
        {
            if (Analizado) dano = dano * 3 / 2;
            return base.RecibirDano(dano);
        }

        public override string Reaccionar(Explorador cadete)
        {
            int dano = cadete.RecibirDano(Ataque + Azar.Rng.Next(-3, 4));
            return $"👾 {Nombre} contraataca: -{dano} vida.";
        }

        public override string Describir()
        {
            if (!Analizado) return $"Enemigo {Nombre} | Datos incompletos (analiza para ver su debilidad)";
            return $"Enemigo {Nombre} | Vida {Vida}/{VidaMax} | Ataque {Ataque} | Debilidad detectada: +50% de daño";
        }
    }

